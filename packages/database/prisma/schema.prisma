// Draft schema, see docs/DATABASE_SCHEMA.md for the reasoning behind the
// non-obvious choices (price snapshots, JSON discount config, separate
// Customer/StaffUser tables, etc.). This is a starting point for Phase 1,
// not final: expect it to move once the open decisions in
// docs/OPEN_DECISIONS.md are settled.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved connection URLs out of schema.prisma into prisma.config.ts
// (CLI/migrations) and the PrismaClient driver adapter (runtime queries),
// see prisma.config.ts and src/client.ts in this package.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model Customer {
  id              String         @id @default(cuid())
  email           String?        @unique
  emailVerifiedAt DateTime?
  phone           String?        @unique
  phoneVerifiedAt DateTime?
  name            String?
  status          CustomerStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  addresses         Address[]
  orders            Order[]
  cart              Cart?
  reviews           Review[]
  consentLogs       ConsentLog[]
  dataRequests      DataSubjectRequest[]
  couponRedemptions CouponRedemption[]
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
}

model Address {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  type       AddressType
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([customerId])
}

enum AddressType {
  SHIPPING
  BILLING
}

// StaffUser is deliberately separate from Customer: different auth flow
// (password, not OTP-only), different threat model. See docs/ARCHITECTURE.md.
model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  roles        StaffUserRole[]
  auditLogs    AuditLog[]
  trackedLinks TrackedLink[]
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  permissions RolePermission[]
  staffUsers  StaffUserRole[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "product:create", "inventory:adjust"
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model StaffUserRole {
  staffUserId String
  roleId      String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id])
  role        Role      @relation(fields: [roleId], references: [id])

  @@id([staffUserId, roleId])
}

// Hashed OTP challenges for both signup/login and checkout verification.
// The code itself is never stored in plaintext.
model OtpChallenge {
  id          String     @id @default(cuid())
  identifier  String // email or phone
  channel     OtpChannel
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  requestIp   String?
  createdAt   DateTime   @default(now())

  @@index([identifier, purpose])
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  CHECKOUT_VERIFY
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  imageUrl  String?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)

  // Nullable overrides for apps/web's generateMetadata, falls back to a
  // computed default (from name) when unset. Same pair as Product below.
  metaTitle       String?
  metaDescription String?

  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  description String?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  // PDP content, all optional, shared across variants (doesn't vary by
  // size/color). `specs` is an ordered [{label, value}] array: the key set
  // genuinely varies by category (paddle specs vs. apparel specs), same
  // reasoning as ProductVariant.attributes and DiscountRule.config. The
  // three ratings are plain nullable columns, not JSON, since their shape
  // never varies (three named 0-100 numbers), only their applicability
  // does; a yoga mat product simply leaves them null.
  specs            Json?
  whoThisIsFor     String?
  careInstructions String?
  powerRating      Int?
  spinRating       Int?
  controlRating    Int?
  // Short "⬥"-separated highlight tags shown under the PDP title (e.g.
  // "USAPA Approved"), a curated subset, distinct from the full `specs`
  // table. Plain string array: shape never varies, so no JSON needed.
  highlightTags    String[] @default([])

  // Nullable overrides for apps/web's generateMetadata, falls back to a
  // computed default (from name/description/highlightTags) when unset.
  metaTitle       String?
  metaDescription String?

  variants         ProductVariant[]
  images           ProductImage[]
  reviews          Review[]
  faqs             Faq[]
  reviewPlacements ReviewPlacement[]

  @@index([categoryId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Infrastructure, not customer/order data, hard delete, no admin UI. Rows
// are only ever written automatically, from inside updateProduct/
// deleteProduct/updateCategory (packages/core/src/admin/), when a slug
// changes or a product is archived, so an old /product or /collection URL
// 301s to the new location instead of 404ing. Consumed page-level (only on
// the not-found path) by apps/web/app/product/[slug]/page.tsx and
// apps/web/app/collection/[slug]/page.tsx, not proxy.ts, see
// docs/OPEN_DECISIONS.md's SEO entry for why.
model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  createdAt DateTime @default(now())

  @@index([fromPath])
}

model ProductVariant {
  id             String        @id @default(cuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  sku            String        @unique
  // e.g. { "size": "M", "color": "Navy" }, kept as JSON so new attributes
  // don't require a migration.
  attributes     Json
  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  weightGrams    Int?
  status         ProductStatus @default(ACTIVE)

  images        ProductImage[]
  inventory     Inventory[]
  inventoryLogs InventoryLog[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId])
}

model ProductImage {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  url              String
  altText          String?
  sortOrder        Int             @default(0)
  isPlaceholder    Boolean         @default(true)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Warehouse {
  id      String  @id @default(cuid())
  name    String
  address String?

  inventory Inventory[]
}

model Inventory {
  id               String         @id @default(cuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id])
  quantityOnHand   Int            @default(0)
  quantityReserved Int            @default(0)
  reorderThreshold Int            @default(0)

  @@unique([productVariantId, warehouseId])
}

model InventoryLog {
  id               String                @id @default(cuid())
  // Expand phase: nullable until every row is backfilled, then a later
  // migration can make it required. variantSku stays as the SKU at the time
  // of the change (a snapshot, survives a later SKU rename).
  productVariantId String?
  productVariant   ProductVariant?       @relation(fields: [productVariantId], references: [id])
  variantSku       String
  changeQty        Int
  reason           InventoryChangeReason
  actorType        ActorType
  actorId          String?
  createdAt        DateTime              @default(now())

  @@index([productVariantId, createdAt])
}

enum InventoryChangeReason {
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT
}

enum ActorType {
  STAFF
  SYSTEM
}

// ---------------------------------------------------------------------------
// Cart & orders
// ---------------------------------------------------------------------------

model Cart {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
  updatedAt  DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id               String         @id @default(cuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id])
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int

  @@unique([cartId, productVariantId])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  discountTotal     Decimal     @default(0) @db.Decimal(10, 2)
  taxTotal          Decimal     @default(0) @db.Decimal(10, 2)
  shippingTotal     Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  currency          String      @default("INR")
  shippingAddressId String
  billingAddressId  String
  couponCode        String?
  placedAt          DateTime    @default(now())
  deletedAt         DateTime?

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  payments         Payment[]
  returnRequests   ReturnRequest[]
  couponRedemption CouponRedemption?

  @@index([customerId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

// Price fields are snapshotted at purchase time, never joined live from
// ProductVariant. See docs/DATABASE_SCHEMA.md.
model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  unitPrice        Decimal        @db.Decimal(10, 2)
  discountAmount   Decimal        @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal        @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal        @db.Decimal(10, 2)

  returnRequests ReturnRequest[]

  @@index([orderId])
}

// Every status change is a row, this is what powers order tracking.
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  changedBy String // "system", a courier webhook id, or a StaffUser id
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String // e.g. "razorpay", see docs/OPEN_DECISIONS.md
  providerPaymentId String
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(INITIATED)
  createdAt         DateTime      @default(now())

  @@index([orderId])
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])
  orderItemId String
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])
  reason      String
  status      ReturnStatus @default(REQUESTED)
  requestedAt DateTime     @default(now())
  resolvedAt  DateTime?

  @@index([orderId])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  REFUNDED
}

// ---------------------------------------------------------------------------
// Discounts, see .claude/skills/discount-rule-engine/ before adding a type
// ---------------------------------------------------------------------------

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  description      String?
  isActive         Boolean   @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  minOrderValue    Decimal?  @db.Decimal(10, 2)

  rules       DiscountRule[]
  redemptions CouponRedemption[]
}

model DiscountRule {
  id        String       @id @default(cuid())
  couponId  String?
  coupon    Coupon?      @relation(fields: [couponId], references: [id])
  type      DiscountType
  // Typed and validated by a zod schema per `type` in packages/core,
  // e.g. { "percentage": 20 } or { "buyQty": 2, "getQty": 1 }.
  config    Json
  priority  Int          @default(0)
  stackable Boolean      @default(false)
}

enum DiscountType {
  PERCENTAGE
  FLAT
  BUY_X_GET_Y
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id])
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  discountAmount Decimal  @db.Decimal(10, 2)
  redeemedAt     DateTime @default(now())

  @@index([couponId, customerId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id            String       @id @default(cuid())
  targetType    ReviewTarget
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id])
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  source        ReviewSource
  rating        Int
  title         String?
  body          String
  authorDisplay String?
  isApproved    Boolean      @default(false)
  submittedAt   DateTime     @default(now())
  approvedAt    DateTime?
  approvedBy    String?
  externalRef   String? // source URL/ID for imported reviews, dedup + traceability

  placements ReviewPlacement[]

  @@index([productId, isApproved])
  @@index([source, externalRef])
}

enum ReviewTarget {
  PRODUCT
  BRAND
}

enum ReviewSource {
  SITE
  EMAIL
  AMAZON_IMPORT
}

// Which storefront surface an approved review is curated onto, and in what
// order. Purely opt-in: a surface (or a product's PRODUCT_WALL) with no
// placements falls back to the most-recent-approved reviews for that
// surface at read time, see listSurfaceReviews in packages/core. Not a
// customer/order/audit entity, so no soft delete here, matching Faq/
// ProductImage.
enum ReviewSurface {
  HOME_HERO // Homepage TestimonialTile, single-review hero card
  HOME_WALL // Homepage ReviewWall, brand reviews grid
  PRODUCT_WALL // PDP ReviewWall, per-product reviews grid
}

model ReviewPlacement {
  id        String        @id @default(cuid())
  surface   ReviewSurface
  // Set only for PRODUCT_WALL (which product's wall this review is featured
  // on); null for the two brand-wide surfaces. Postgres treats NULL as
  // distinct in unique constraints, so the @@unique below does not by
  // itself stop duplicate HOME_HERO/HOME_WALL rows for the same review,
  // packages/core's setReviewPlacement checks for an existing row first.
  productId String?
  product   Product?      @relation(fields: [productId], references: [id])
  reviewId  String
  review    Review        @relation(fields: [reviewId], references: [id])
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@unique([surface, productId, reviewId])
  @@index([surface, productId])
}

// One configurable display-limit per surface (e.g. "show at most 6 on the
// PDP wall"). productId is only meaningful for PRODUCT_WALL, null there
// means "the global default for every product without its own override";
// HOME_HERO/HOME_WALL are site-wide and always use productId: null. A
// surface(+product) with no row here falls back to an in-code default,
// see DEFAULT_SURFACE_LIMITS in packages/core.
model ReviewSurfaceConfig {
  id        String        @id @default(cuid())
  surface   ReviewSurface
  productId String?
  limit     Int

  @@unique([surface, productId])
}

// ---------------------------------------------------------------------------
// FAQs
// ---------------------------------------------------------------------------

// productId null = a general/site-wide FAQ; set = shown on that product's PDP.
model Faq {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isActive])
}

// ---------------------------------------------------------------------------
// Compliance (DPDP), see docs/SECURITY_AND_DPDP.md
// ---------------------------------------------------------------------------

model ConsentLog {
  id          String      @id @default(cuid())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  consentType ConsentType
  version     String
  acceptedAt  DateTime    @default(now())
  ipAddress   String?

  @@index([customerId])
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING
}

model DataSubjectRequest {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  type        DsrType
  status      DsrStatus @default(RECEIVED)
  requestedAt DateTime  @default(now())
  fulfilledAt DateTime?
}

enum DsrType {
  ACCESS
  ERASURE
  CORRECTION
}

enum DsrStatus {
  RECEIVED
  IN_PROGRESS
  FULFILLED
  REJECTED
}

// ---------------------------------------------------------------------------
// Site configuration
// ---------------------------------------------------------------------------

// Which public-facing mode the storefront is in, read by apps/web/proxy.ts
// to decide whether to gate every route to /waitlist. WAITLIST is pre-launch
// (this table's initial state); PREORDERS unlocks browsing plus the
// pre-order flow (built separately, see docs/OPEN_DECISIONS.md); LIVE is the
// normal storefront with checkout.
enum SiteMode {
  WAITLIST
  PREORDERS
  LIVE
}

// Single-row site-wide config, admin-editable via apps/admin's /settings
// page. A fixed id enforces the single row instead of a generic key-value
// table, three knobs don't need that abstraction yet.
model SiteSetting {
  id                      String   @id @default("singleton")
  siteMode                SiteMode @default(WAITLIST)
  // Countdown target on /waitlist and the gate the PREORDERS mode switch
  // gets flipped by hand around, not derived, an admin sets it directly.
  launchAt                DateTime
  // false swaps the /waitlist countdown for a "Coming soon" message.
  showCountdown           Boolean  @default(true)
  // Whether WaitlistEntry.phone accepts any valid international number or
  // only Indian mobile numbers, see packages/core/src/validation/phone.ts.
  allowInternationalPhone Boolean  @default(true)
  // Social links shown in apps/web's SiteFooter and WaitlistFooter, null
  // means "don't show this icon" rather than a dead "#" link, which is
  // what every one of these defaulted to before this field existed.
  instagramUrl            String?
  linkedinUrl             String?
  facebookUrl             String?
  youtubeUrl              String?
  spotifyUrl              String?
  updatedAt               DateTime @updatedAt
  updatedByStaffId        String?
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String? // e.g. "homepage_footer", provenance, not required
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  // Proof of consent (DPDP / GDPR): the Privacy Policy version the person
  // ticked the box against, when, and from where. Null on rows that predate
  // the checkbox, those have no proof of consent.
  consentVersion String?
  consentedAt    DateTime?
  ipAddress      String?
}

// Pre-launch signups from the /waitlist page, distinct from
// NewsletterSubscriber because this is a real identity capture (name +
// phone required, not just email) used to seed launch-day access, not a
// mailing list. Never hard-deleted, same reasoning as Customer: it's
// DPDP-covered personal data, an unsubscribe just stops contact.
model WaitlistEntry {
  id             String    @id @default(cuid())
  fullName       String
  email          String    @unique
  // Stored normalized (E.164) so "+911234567890" and a bare local-format
  // entry of the same number collapse to one row instead of two.
  phone          String    @unique
  // Optional "fridge run" -> "full marathon" engagement slider from the
  // signup form, marketing color, not required for the entry to be valid.
  movementFlex   Int?
  source         String?
  // Terms/Privacy version accepted at submit time, see ConsentLog and
  // docs/SECURITY_AND_DPDP.md; kept inline rather than a ConsentLog row
  // since a waitlist signup isn't a Customer yet.
  consentVersion String
  ipAddress      String?
  // Where the visitor was when they signed up, read from the host's
  // IP-geolocation headers (city level, approximate). Null when the host
  // sent none (local dev, privacy tools).
  country        String?
  region         String?
  city           String?
  // Host of the page that sent them here (e.g. "l.instagram.com"), and the
  // first-touch UTM values from the link they arrived on. All optional.
  referrerHost   String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  submittedAt    DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([submittedAt])
}

// Homepage and PDP shared marketing content, CMS-editable so it isn't
// baked into page source as hardcoded consts. Not customer/order/audit
// data, so hard delete (like Faq), not soft delete.
model ValueProp {
  id              String  @id @default(cuid())
  illustrationUrl String
  width           Int
  height          Int
  title           String
  body            String
  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)
}

model InstagramPhoto {
  id        String  @id @default(cuid())
  imageUrl  String
  altText   String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

// Which marquee ticker a line of text belongs to, Homepage has two
// (hero + showcase), the PDP has its own.
enum MarqueePlacement {
  HOME_HERO
  HOME_SHOWCASE
  PDP
}

model MarqueeItem {
  id        String           @id @default(cuid())
  placement MarqueePlacement
  label     String
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)

  @@index([placement, isActive])
}

// Same category as ValueProp/InstagramPhoto/MarqueeItem above, admin-
// authored marketing/editorial content, not customer/order/audit data, so
// hard delete (isPublished flag instead of deletedAt) matches those, not
// Product's soft-delete convention. Backs apps/web's /journal/[slug] and
// the homepage's "From the Playbook" section.
model Article {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String?
  bodyHtml      String
  coverImageUrl String?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

// Privacy Policy and Terms pages. One row per page (slug "privacy" or
// "terms"), its points live in LegalSection rows so staff can add, reword,
// hide and reorder each one from apps/admin's Content > Legal pages tab.
// Backs apps/web's /privacy and /terms. Marketing-style content, so sections
// can be hidden (isActive) or really deleted, same as Faq/ValueProp.
model LegalPage {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  intro            String?
  sections         LegalSection[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  updatedByStaffId String?
}

model LegalSection {
  id        String    @id @default(cuid())
  pageId    String
  page      LegalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  heading   String
  // Plain text. A blank line starts a new paragraph, lines starting with
  // "- " are bullet points. See formatLegalBody in packages/core.
  body      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([pageId, sortOrder])
}

// ---------------------------------------------------------------------------
// Audit & analytics
// ---------------------------------------------------------------------------

model AuditLog {
  id          String     @id @default(cuid())
  actorType   ActorType
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id])
  action      String // e.g. "inventory.adjust", "review.approve"
  entityType  String
  entityId    String
  beforeState Json?
  afterState  Json?
  createdAt   DateTime   @default(now())

  @@index([entityType, entityId])
}

// Tagged links staff made in the admin link builder, kept so they can be
// copied again and campaign names get reused instead of retyped. Internal
// tool data (no money, stock or access), so hard delete and no audit row.
model TrackedLink {
  id          String     @id @default(cuid())
  // The full tagged URL. Unique so making the same link twice reuses the row.
  url         String     @unique
  channelId   String // an id from UTM_CHANNELS
  pagePath    String // e.g. "/ontheway" or "/product/<slug>"
  campaign    String // already a slug
  content     String? // the optional extra label, already a slug
  createdById String?
  createdBy   StaffUser? @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([createdAt])
}

// Funnel events for the admin analytics dashboard. Kept intentionally thin,
// see docs/ARCHITECTURE.md on why aggregation shouldn't hit this table live.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  sessionId  String
  customerId String?
  eventType  String // e.g. "product_viewed", "checkout_started"
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([eventType, createdAt])
}
