# Postgres connection strings (Neon via Vercel Postgres). DATABASE_URL is the
# pooled connection (via PgBouncer) used for normal app queries; DIRECT_URL
# is the non-pooled connection Prisma Migrate needs for advisory locks.
# Get both from the provisioned database instance, never commit real values.
DATABASE_URL=
DIRECT_URL=

# Server-only secret used to HMAC-hash OTP codes before storing them
# (packages/auth/src/otp/generateOtpCode.ts). Generate with, e.g.,
# `openssl rand -hex 32`, never commit a real value here.
OTP_HASH_SECRET=

# Server-only secret used to sign the placeholder session cookie
# (packages/auth/src/session/session.ts), a temporary stand-in for the
# Redis-backed sessions in root CLAUDE.md's tech stack. Generate with, e.g.,
# `openssl rand -hex 32`, never commit a real value here.
SESSION_JWT_SECRET=

# apps/admin (CMS), separate from everything above so a leaked storefront
# secret can never be used to forge a staff session (see docs/ARCHITECTURE.md
# "RBAC and the two kinds of user").

# The staff account that gets every permission automatically on first run
# (packages/auth/src/rbac/getStaffPermissions.ts), no Role/Permission rows
# needed for this one account. After that, role management happens in the
# CMS itself.
SUPERADMIN_EMAIL=

# Plaintext only ever lives here, in a local .env, the seed script
# (packages/database/prisma/seed.ts) hashes it once into StaffUser.passwordHash
# and never stores or logs the plaintext anywhere else.
SUPERADMIN_INITIAL_PASSWORD=

# Server-only secret used to sign the admin session cookie
# (packages/auth/src/session/staffSession.ts). Generate with, e.g.,
# `openssl rand -hex 32`, never commit a real value here, and never reuse
# SESSION_JWT_SECRET's value for this.
ADMIN_SESSION_JWT_SECRET=

# Vercel Blob read/write token for product/category image uploads
# (apps/admin). Auto-injected by Vercel when the Blob store is connected to
# the project; get a local value from vercel.com/dashboard's Storage tab.
BLOB_READ_WRITE_TOKEN=

# Upstash Redis REST credentials, used for sliding-window rate limiting
# (packages/core/src/rateLimit/lazyLimiter.ts). Without these set, waitlist and
# newsletter signups are not rate limited, and in production staff login and
# OTP requests are refused. Get both from the Upstash console (a Redis
# database's REST API tab) or the Vercel Marketplace integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Staff login and OTP requests refuse to run in production without the two
# Upstash values above (fail closed). Set this to true only to deliberately
# run production without rate limiting.
RATE_LIMIT_ALLOW_UNCONFIGURED=

# Shared secret admin uses to tell the storefront's catalog cache to
# revalidate immediately after a catalog edit, instead of waiting out
# cachedCatalog's 60s window (apps/web/app/api/revalidate/route.ts,
# apps/admin/app/api/_lib/triggerCatalogRevalidate.ts). Generate with, e.g.,
# openssl rand -hex 32. Never commit a real value here.
REVALIDATE_SECRET=

# The storefront's own base URL, so apps/admin knows where to send that
# ping. Local dev: http://localhost:3000
WEB_APP_URL=

# apps/web's own public origin, used by app/sitemap.ts, app/robots.ts, and
# app/layout.tsx's metadataBase for building absolute URLs (see
# apps/web/lib/seo/siteUrl.ts). Falls back to https://onwei.in if unset, so
# only a preview/staging deploy actually needs this set.
NEXT_PUBLIC_SITE_URL=

# Resend (https://resend.com) for welcome emails, packages/emails/src/sender.
# Without RESEND_API_KEY the app only logs emails to the server console.
# EMAIL_FROM must be on a domain verified in Resend (SPF and DKIM records).
RESEND_API_KEY=
EMAIL_FROM="Onwei <hello@onwei.in>"
# Optional. Where customer replies go.
EMAIL_REPLY_TO=

# Visitor analytics (PostHog). The public project key (phc_...) is safe in the
# browser. The access key (phx_...) reads data back for the admin dashboard and
# is a secret: server-only, never NEXT_PUBLIC_. Leave unset locally to send
# nothing.
# apps/web:
NEXT_PUBLIC_POSTHOG_KEY=
# Ingest host for the project's region: us.i.posthog.com or eu.i.posthog.com.
POSTHOG_INGEST_HOST=
# apps/admin:
# Read host for the region: https://us.posthog.com or https://eu.posthog.com.
POSTHOG_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# Which environment's events the dashboard counts (default: production).
POSTHOG_ENVIRONMENT=
