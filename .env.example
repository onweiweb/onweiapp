# Postgres connection strings (Neon via Vercel Postgres). DATABASE_URL is the
# pooled connection (via PgBouncer) used for normal app queries; DIRECT_URL
# is the non-pooled connection Prisma Migrate needs for advisory locks.
# Get both from the provisioned database instance — never commit real values.
DATABASE_URL=
DIRECT_URL=

# Server-only secret used to HMAC-hash OTP codes before storing them
# (packages/auth/src/otp/generateOtpCode.ts). Generate with, e.g.,
# `openssl rand -hex 32` — never commit a real value here.
OTP_HASH_SECRET=

# Server-only secret used to sign the placeholder session cookie
# (packages/auth/src/session/session.ts) — a temporary stand-in for the
# Redis-backed sessions in root CLAUDE.md's tech stack. Generate with, e.g.,
# `openssl rand -hex 32` — never commit a real value here.
SESSION_JWT_SECRET=

# apps/admin (CMS) — separate from everything above so a leaked storefront
# secret can never be used to forge a staff session (see docs/ARCHITECTURE.md
# "RBAC and the two kinds of user").

# The staff account that gets every permission automatically on first run
# (packages/auth/src/rbac/getStaffPermissions.ts) — no Role/Permission rows
# needed for this one account. After that, role management happens in the
# CMS itself.
SUPERADMIN_EMAIL=

# Plaintext only ever lives here, in a local .env — the seed script
# (packages/database/prisma/seed.ts) hashes it once into StaffUser.passwordHash
# and never stores or logs the plaintext anywhere else.
SUPERADMIN_INITIAL_PASSWORD=

# Server-only secret used to sign the admin session cookie
# (packages/auth/src/session/staffSession.ts). Generate with, e.g.,
# `openssl rand -hex 32` — never commit a real value here, and never reuse
# SESSION_JWT_SECRET's value for this.
ADMIN_SESSION_JWT_SECRET=

# Vercel Blob read/write token for product/category image uploads
# (apps/admin). Auto-injected by Vercel when the Blob store is connected to
# the project; get a local value from vercel.com/dashboard's Storage tab.
BLOB_READ_WRITE_TOKEN=
