{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "OTP_HASH_SECRET",
    "SESSION_JWT_SECRET",
    "SUPERADMIN_EMAIL",
    "SUPERADMIN_INITIAL_PASSWORD",
    "ADMIN_SESSION_JWT_SECRET",
    "BLOB_READ_WRITE_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "test", "typecheck"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "db:generate": {
      "cache": true,
      "outputs": [
        "../../node_modules/@prisma/client/**",
        "../../node_modules/.prisma/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
