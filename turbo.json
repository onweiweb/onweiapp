{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "test", "typecheck"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "db:generate": {
      "cache": true,
      "outputs": [
        "../../node_modules/@prisma/client/**",
        "node_modules/.prisma/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
